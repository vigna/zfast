+#[inline(always)]
+#[allow(unused_unsafe)]
+fn crc_step(state: u32, word: u64) -> u32 {
+    #[cfg(all(target_arch = "x86_64", target_feature = "sse4.2"))]
+    unsafe {
+        core::arch::x86_64::_mm_crc32_u64(state as u64, word) as u32
+    }
+    #[cfg(all(target_arch = "aarch64", target_feature = "crc"))]
+    unsafe {
+        core::arch::aarch64::__crc32cd(state, word)
+    }
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Crc2;
+
+pub struct Crc2Hasher<'a> {
+    key: &'a [u8],
+    seed: u64,
+    inline: [MaybeUninit<u32>; INLINE],
+}
+
+impl HashPrefixes for Crc2 {
+    type Hasher<'a> = Crc2Hasher<'a>;
+
+    #[inline]
+    fn hash_prefix(key: &[u8], f: usize, seed: u64) -> u64 {
+        Self::hasher(key, f, seed).hash(f)
+    }
+
+    #[inline(always)]
+    fn hasher(key: &[u8], limit: usize, seed: u64) -> Crc2Hasher<'_> {
+        let n = (limit / 8).min(INLINE - 1);
+        let mut hasher = Crc2Hasher { key, seed, inline: [MaybeUninit::uninit(); INLINE] };
+        let mut state = !(seed as u32);
+        hasher.inline[0].write(state);
+        for (i, w) in key[..8 * n].chunks_exact(8).enumerate() {
+            state = crc_step(state, u64::from_le_bytes(w.try_into().unwrap()));
+            hasher.inline[i + 1].write(state);
+        }
+        hasher
+    }
+}
+
+impl PrefixHasher for Crc2Hasher<'_> {
+    #[inline(always)]
+    fn hash(&self, f: usize) -> u64 {
+        // EXPERIMENT: keys longer than 256 bytes are not supported
+        let state = unsafe { self.inline.get_unchecked(f / 8).assume_init() };
+        let state = crc_step(state, tail(self.key, f));
+        let z = (((state as u64) << 32 | (f as u64 & 0xFFFF_FFFF)) ^ self.seed).wrapping_mul(K1 | 1);
+        let z = (z ^ (z >> 32)).wrapping_mul(K3 | 1);
+        z ^ (z >> 32)
+    }
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Crc1;
+
+pub struct Crc1Hasher<'a> {
+    key: &'a [u8],
+    seed: u64,
+    inline: [MaybeUninit<u32>; INLINE],
+}
+
+impl HashPrefixes for Crc1 {
+    type Hasher<'a> = Crc1Hasher<'a>;
+
+    #[inline]
+    fn hash_prefix(key: &[u8], f: usize, seed: u64) -> u64 {
+        Self::hasher(key, f, seed).hash(f)
+    }
+
+    #[inline(always)]
+    fn hasher(key: &[u8], limit: usize, seed: u64) -> Crc1Hasher<'_> {
+        let n = (limit / 8).min(INLINE - 1);
+        let mut hasher = Crc1Hasher { key, seed, inline: [MaybeUninit::uninit(); INLINE] };
+        let mut state = !(seed as u32);
+        hasher.inline[0].write(state);
+        for (i, w) in key[..8 * n].chunks_exact(8).enumerate() {
+            state = crc_step(state, u64::from_le_bytes(w.try_into().unwrap()));
+            hasher.inline[i + 1].write(state);
+        }
+        hasher
+    }
+}
+
+impl PrefixHasher for Crc1Hasher<'_> {
+    #[inline(always)]
+    fn hash(&self, f: usize) -> u64 {
+        // EXPERIMENT: keys longer than 256 bytes are not supported
+        let state = unsafe { self.inline.get_unchecked(f / 8).assume_init() };
+        let state = crc_step(state, tail(self.key, f));
+        (((state as u64) << 32 | (f as u64 & 0xFFFF_FFFF)) ^ self.seed).wrapping_mul(K1 | 1)
+    }
+}
